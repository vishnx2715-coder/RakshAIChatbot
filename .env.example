# ─── RAKSHA .env.example ─────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. See .gitignore.
# ─────────────────────────────────────────────────────────────

# Flask session signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Groq AI — https://console.groq.com (free, no credit card needed)
GROQ_API_KEY=

# OpenWeatherMap — https://openweathermap.org/api (free tier available)
# Supports both OPENWEATHER_API_KEY and legacy WEATHER_API_KEY
OPENWEATHER_API_KEY=

# Supabase — https://supabase.com → Project Settings → API
# Use the project 'anon' or 'service_role' key (NOT the Management API key)
SUPABASE_URL=
SUPABASE_KEY=

# Google OAuth 2.0 Client ID — https://console.cloud.google.com
# Create a Web application credential, add your domain to Authorized Origins
GOOGLE_CLIENT_ID=

# Google Maps JavaScript API — https://console.cloud.google.com
# Enable: Maps JavaScript API, Places API
GOOGLE_MAPS_KEY=

# OpenRouteService — https://openrouteservice.org (2000 req/day free)
ORS_API_KEY=

# Redis — required in production for caching (Phase 6+)
# Local: redis://localhost:6379
# Render: add a Redis instance and copy the Internal URL
REDIS_URL=
